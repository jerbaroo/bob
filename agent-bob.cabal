cabal-version:      3.14
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'agent-bob' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               agent-bob

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
synopsis:           Agent harness

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            BSD-3-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             jerbaroo

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         jerbaroo.work@pm.me

-- A copyright notice.
-- copyright:
category:           Development
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall -Wno-ambiguous-fields

library
    -- Import common warning flags.
    import:           warnings

    -- Modules exported by the library.
    exposed-modules:  Agent.Bob
                    , Agent.Bob.Command
                    , Agent.Bob.Command.CallAgent
                    , Agent.Bob.Command.ReadConsole
                    , Agent.Bob.Config
                    , Agent.Bob.Config.Cli
                    , Agent.Bob.Config.File
                    , Agent.Bob.Data.AgentId
                    , Agent.Bob.Data.AgentInput
                    , Agent.Bob.Data.AgentOutput
                    , Agent.Bob.Data.Config
                    , Agent.Bob.Data.Event
                    , Agent.Bob.Data.Event.Registry
                    , Agent.Bob.Data.FinishReason
                    , Agent.Bob.Data.HarnessState
                    , Agent.Bob.Data.Level
                    , Agent.Bob.Data.Message
                    , Agent.Bob.Data.Resolution
                    , Agent.Bob.Data.Role
                    , Agent.Bob.Data.Skill
                    , Agent.Bob.Data.Task
                    , Agent.Bob.Data.Temperature
                    , Agent.Bob.Data.Thinking
                    , Agent.Bob.Data.ToolName
                    , Agent.Bob.Data.ToolResult
                    , Agent.Bob.Data.Permission
                    , Agent.Bob.Data.UserInput
                    , Agent.Bob.Effect.Agent
                    , Agent.Bob.Effect.Clock
                    , Agent.Bob.Effect.Console
                    , Agent.Bob.Effect.File
                    , Agent.Bob.Effect.Harness
                    , Agent.Bob.Effect.Permission
                    , Agent.Bob.Glob
                    , Agent.Bob.Permissions
                    , Agent.Bob.Prelude
                    , Agent.Bob.Prelude.Typeable
                    , Agent.Bob.Pretty
                    , Agent.Bob.ProjectRoot
                    , Agent.Bob.Prompt
                    , Agent.Bob.Prompt.Build
                    , Agent.Bob.Session
                    , Agent.Bob.Skill
                    , Agent.Bob.Soul
                    , Agent.Bob.Tool
                    , Agent.Bob.Tool.ReadFiles
                    , Agent.Bob.Tool.Registry
                    , Agent.Bob.UserCommand
                    , Agent.Bob.UserCommand.ActivateSkill
                    , Agent.Bob.UserCommand.AgentCall
                    , Agent.Bob.UserCommand.ConfigShow
                    , Agent.Bob.UserCommand.DeactivateSkill
                    , Agent.Bob.UserCommand.Help
                    , Agent.Bob.UserCommand.Init
                    , Agent.Bob.UserCommand.Name
                    , Agent.Bob.UserCommand.PermissionsShow
                    , Agent.Bob.UserCommand.Resume
                    , Agent.Bob.UserCommand.Registry
                    , Agent.Bob.UserCommand.Registry.Base
                    , Agent.Bob.UserCommand.Soul
                    , Agent.Bob.UserCommand.StateShow

    -- Modules included in this library but not exported.
    -- other-modules:

    default-extensions: AllowAmbiguousTypes
                      , BlockArguments
                      , DefaultSignatures
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , NoImplicitPrelude
                      , OverloadedRecordDot
                      , OverloadedStrings
                      , RecordWildCards
                      , TemplateHaskell
                      , TypeFamilies
                      , UndecidableInstances

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    Glob
                    , QuickCheck
                    , aeson
                    , aeson-pretty
                    , base
                    , bytestring
                    , containers
                    , directory
                    , extra
                    , filepath
                    , frontmatter
                    , heftia
                    , heftia-effects
                    , http-client
                    , http-client-tls
                    , optparse-applicative
                    , quickcheck-instances
                    , random
                    , request
                    , safe
                    , text
                    , time
                    , witch

    -- Directories containing source files.
    hs-source-dirs:   src

    -- Base language which the package is written in.
    default-language: GHC2024

executable agent-bob
    -- Import common warning flags.
    import:           warnings

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:
        base,
        agent-bob

    -- Directories containing source files.
    hs-source-dirs:   app

    -- Base language which the package is written in.
    default-language: GHC2024

test-suite agent-bob-test
    -- Import common warning flags.
    import:           warnings

    -- Base language which the package is written in.
    default-language: GHC2024

    -- Modules included in this executable, other than Main.
    other-modules:    Test.Config
                    , Test.Event
                    , Test.File
                    , Test.Permission
                    , Test.ProjectRoot
                    , Test.Prompt
                    , Test.Schema
                    , Test.Session

    default-extensions: AllowAmbiguousTypes
                      , BlockArguments
                      , DefaultSignatures
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , NoImplicitPrelude
                      , OverloadedRecordDot
                      , OverloadedStrings
                      , RecordWildCards
                      , TemplateHaskell
                      , TypeFamilies
                      , UndecidableInstances

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files.
    hs-source-dirs:   test

    -- The entrypoint to the test suite.
    main-is:          Main.hs

    -- Test dependencies.
    build-depends:
        QuickCheck,
        aeson,
        agent-bob,
        base,
        hspec,
        optparse-applicative,
        temporary,
        text,
        time
